  "assumptions": [
    "Abstract root elapsed-time upper bound and conservative request-start permission",
    "Atomic durable placement updates with synchronized issuer assignment view",
    "Never-reused writer generations, independent of coordinator epochs; replacement writers cannot reuse a generation",
    "Durable immutable object identities and fresh per-key positive and negative observations",
    "Atomic immutable prefix selection conditioned on current coordinator authority; exact validated reads of selected prefixes"
  ],
  "coverage": {
    "movement": "Second generation serves the acknowledged prefix of its predecessor",
    "interrupted_movement": "A replacement root actually finishes the frozen move; the successor inherits the old acknowledgement",
    "independent_partitions": "Moved partition generation two and untouched partition generation one simultaneously serve their respective acknowledged histories",
    "repeated_movement": "Third generation inherits one acknowledged batch from each predecessor",
    "surviving_writer": "One generation acknowledges batch one under root one and batch two under root two; acknowledgingRoots = {1, 2}",
    "liveness_proved": false
  },
  "limitations": [
    "Finite regressions are separate instances; the unbounded theorem covers arbitrary finite roots, partitions and writer generations, with unbounded log lengths, executions and renewals under its stated assumptions",
    "The abstract theorem is not an implementation refinement proof or a platform timing guarantee",
    "Atomic selection and synchronized freeze abstract wire uncertainty; no controller implementation",
    "No platform timing or clock-conversion refinement",
    "No transaction evaluation, receipts, admission, retention, reclamation or liveness",
